<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Projetos Shared expõem contratos públicos: todo membro público precisa de XML doc (CLAUDE.md). -->
    <NoWarn>$(NoWarn.Replace('CS1591', ''))</NoWarn>
  </PropertyGroup>

</Project>
